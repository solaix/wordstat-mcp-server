{
  "name": "wordstat-mcp-server",
  "version": "0.1.0",
  "mcpName": "io.github.solaix/wordstat-mcp-server",
  "description": "Unofficial MCP server for Yandex Wordstat",
  "author": {
    "name": "solaix",
    "url": "https://github.com/solaix"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solaix/wordstat-mcp-server.git"
  },
  "homepage": "https://github.com/solaix/wordstat-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/solaix/wordstat-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "wordstat",
    "yandex",
    "seo"
  ],
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "bin": {
    "wordstat-mcp-server": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "pretest": "npm run build",
    "test": "node --import tsx scripts/run-tests.ts",
    "contract:probe": "node --import tsx scripts/contract-probe.ts",
    "smoke:live:mcp": "node --import tsx scripts/live-mcp-smoke.ts",
    "smoke:package": "node --import tsx scripts/package-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
