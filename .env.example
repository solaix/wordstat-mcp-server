# Set exactly one credential. Never commit real values.
YANDEX_WORDSTAT_API_KEY=
# YANDEX_WORDSTAT_IAM_TOKEN=

# Required for Yandex account or federated account IAM tokens; omit for service-account credentials.
YANDEX_WORDSTAT_FOLDER_ID=

# Optional neutral probe phrase. It is redacted from saved fixtures.
YANDEX_WORDSTAT_PROBE_PHRASE=велосипед
